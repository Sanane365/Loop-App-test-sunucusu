{
  "buildCommand": "pnpm --filter @workspace/loop-app build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://loop-app-test-sunucusu.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://loop-app-test-sunucusu.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

